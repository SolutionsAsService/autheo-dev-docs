{
  "name": "autheo-dev-docs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:prepare": "node scripts/prepare.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev .build/site --host 127.0.0.1",
    "docs:build": "npm run docs:prepare && vitepress build .build/site && node scripts/check-dist.mjs",
    "docs:preview": "vitepress preview .build/site --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run docs:build",
    "export": "node scripts/export.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "docs:build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "cheerio": "1.2.0",
    "playwright-core": "1.64.0",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
